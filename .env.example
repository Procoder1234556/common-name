# App
NODE_ENV=development
# Canonical / OG / sitemap base — set to public HTTPS URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data
COMPANIES_DB_PATH=./data/companies.sqlite
# Phase 1 uses sql.js (WASM) so Windows machines without VS C++ still work.
# Set to better-sqlite3 only after native rebuild succeeds (Linux CI / VS Build Tools).
COMPANIES_DB_DRIVER=sqljs
# Must be exactly "yes" to allow network download of OGD ZIP
CONFIRM_OGD_DOWNLOAD=no
# Optional: path to already-downloaded ZIP/CSV (skips network)
OGD_LOCAL_PATH=
# Required when CONFIRM_OGD_DOWNLOAD=yes and OGD_LOCAL_PATH empty — direct HTTPS artifact URL
OGD_DOWNLOAD_URL=
# Optional ISO date label for dataset_meta.snapshot_at
OGD_SNAPSHOT_AT=
# Seed copied onto empty COMPANIES_DB_PATH at start (Render disk bootstrap)
COMPANIES_DB_SEED=./data/companies.sqlite.seed

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# MCA deep link (official portal entry — update if MCA moves path)
NEXT_PUBLIC_MCA_VERIFY_URL=https://www.mca.gov.in/
NEXT_PUBLIC_OGD_CATALOG_URL=https://data.gov.in/catalog/company-master-data
