# App
NODE_ENV=development
# Canonical / OG / sitemap base — set to public HTTPS URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data
COMPANIES_DB_PATH=./data/companies.sqlite
# Phase 1 uses sql.js (WASM) so Windows machines without VS C++ still work.
# Set to better-sqlite3 only after native rebuild succeeds (Linux CI / VS Build Tools).
COMPANIES_DB_DRIVER=sqljs
# Must be exactly "yes" to allow network download / API of OGD data
CONFIRM_OGD_DOWNLOAD=no
# Preferred nationwide path: free API key from https://data.gov.in/
DATA_GOV_IN_API_KEY=
# RoC-wise Company Master resource UUID (default is fine)
OGD_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a
# Optional cap for smoke tests (e.g. 5000)
OGD_MAX_ROWS=
# Optional: path to already-downloaded ZIP/CSV (skips network)
OGD_LOCAL_PATH=
# Required when CONFIRM_OGD_DOWNLOAD=yes and no API key / local path — direct HTTPS artifact URL
OGD_DOWNLOAD_URL=
# Optional ISO date label for dataset_meta.snapshot_at
OGD_SNAPSHOT_AT=
# Seed copied onto empty COMPANIES_DB_PATH at start (Render disk bootstrap)
COMPANIES_DB_SEED=./data/companies.sqlite.seed

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# MCA deep link — official Check Company/LLP Name (FO). User verifies live; we never scrape this.
NEXT_PUBLIC_MCA_VERIFY_URL=https://www.mca.gov.in/content/mca/global/en/mca/fo-llp-services/company-llp-name-search.html
NEXT_PUBLIC_OGD_CATALOG_URL=https://data.gov.in/catalog/company-master-data
